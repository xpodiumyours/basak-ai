{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "basak-gate-preview",
  "main": "src/index.js",
  "compatibility_date": "2026-09-19",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "durable_objects": {
    "bindings": [
      { "name": "LAB_STATE", "class_name": "LabState" }
    ]
  },
  "exports": {
    "LabState": { "type": "durable-object", "storage": "sqlite" }
  },
  "limits": { "subrequests": 20 }
}
