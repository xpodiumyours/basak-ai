# Basak — sunucu ortam ornegi
# setup.sh bunu /etc/basak/basak.env'a kopyalar (mod 600).
# BU DOSYA GIT'E GIRER — icine GERCEK sirlar YAZILMAZ.
# Gercek degerler: `npx vercel env pull --environment=production` (yerelde)
# ve sonradan /etc/basak/basak.env icine elle yazilir.

# Uretim modu — ZORUNLU (Vercel algisi yerine kullanilir)
BASAK_URETIM=1

# Kimlik / oturum (Vercel'deki ayni degerler)
BASAK_WEB_TOKEN=
BASAK_OTURUM_ANAHTARI=

# Neon Postgres DSN (basta bulunan okunur: DATABASE_URL once)
DATABASE_URL=
# Aynı DSN istenirse:  POSTGRES_URL=   NEON_DATABASE_URL=

# Kalici state dizini (yoksa /tmp -> reboot'ta silinir)
BASAK_STATE_DIR=/opt/basak/data

# Opsiyonel: anonim kota tavani (yoksa 50)
# BASAK_ANONIM_KOTA_TAVAN=50
