{
  "manifest_version": 3,
  "name": "Başak — sayfa gözü",
  "version": "0.1.0",
  "description": "Başak'ın açık sekmeyi görmesini sağlar. Sohbet Başak'ın kendi ekranında sürer; bu eklenti yalnız göz ve bağlantıdır.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "tabs", "scripting", "sidePanel"],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "ws://127.0.0.1/*",
    "http://127.0.0.1/*",
    "wss://basak-vercel.vercel.app/*",
    "https://basak-vercel.vercel.app/*"
  ],
  "background": { "service_worker": "arka.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["icerik.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": { "default_title": "Başak panelini aç" },
  "side_panel": { "default_path": "panel.html" }
}
